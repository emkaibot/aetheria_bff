# Variables de producción para la pestaña Environment de Dokploy.
# Esto es sólo la plantilla: los valores de verdad NO se versionan.
# Para generar secretos: openssl rand -hex 32

# Dominios (sin https://). Con sslip.io no hace falta comprar uno.
API_HOST=api.92-112-193-74.sslip.io
AUTH_HOST=auth.92-112-193-74.sslip.io

# Symfony
APP_SECRET=

# Bases de datos
POSTGRES_PASSWORD=
KC_DB_PASSWORD=

# Keycloak: el admin de la consola (https://$AUTH_HOST/admin) y el secreto del
# cliente que usa el BFF. El secreto sólo se lee al crear el realm la primera vez.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_SECRET=

# Correo (Gmail con contraseña de aplicación). También sólo al crear el realm;
# después se cambia con configure-realm.sh.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=emkaibot@gmail.com
SMTP_FROM=emkaibot@gmail.com
SMTP_PASSWORD=
