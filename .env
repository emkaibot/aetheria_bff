# Valores por defecto para desarrollo local. Lo de cada máquina va en .env.local.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=dev_only_change_me_8f3a1c
###< symfony/framework-bundle ###

DATABASE_URL="postgresql://eter:eter_pass@db:5432/eter?serverVersion=16&charset=utf8"

# Web de Expo (8290) y cualquier localhost. Nativo no manda Origin.
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

DEFAULT_URI=http://localhost:8280

###> keycloak ###
# KEYCLOAK_URL lo pone docker-compose (http://keycloak:8080, red interna).
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8281
KEYCLOAK_REALM=eter
KEYCLOAK_CLIENT_ID=eter-bff
KEYCLOAK_CLIENT_SECRET=eter-bff-dev-secret
# Admin del realm master: sólo para crear usuarios en el registro.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
